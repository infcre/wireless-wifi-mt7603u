# Test-environment credentials used by the harness in this directory.
#
#   cp .env.example .env      # then edit, and `set -a; . ./.env; set +a`
#
# Every script here reads these from the environment, so nothing is hardcoded.
# The defaults below are throwaway values for a *local VM*: the VM's root
# password is set by tools/owrt-vm-prep.sh when it prepares the disk image, and
# the PSK is for the AP the VM brings up.  Neither is a real credential.

# root password inside the QEMU OpenWrt VM
VM_PASS=openwrt-test

# ssh host port of the VM (QEMU user-net, wan side)
VM_PORT=2223
VM_HOST=127.0.0.1

# SSID/PSK/ channel for the AP the VM brings up in AP mode
SSID=MT7603U-AP
PSK=mt7603u12345
CH=11

# Subnet for that AP (kept away from br-lan and from any real LAN)
SUBNET=192.168.77

# remote Debian/Armbian host used by tools/debian/ssh-run.sh
# (optional: leave unset if you only build locally with tools/debian/build.sh)
DEBIAN_HOST=root@192.168.1.10
DEBIAN_KEY=/root/.ssh/id_ed25519